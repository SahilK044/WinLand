{
  "name": "winland",
  "productName": "WinLand",
  "description": "Fluid, interactive Dynamic Island for Windows featuring high-performance 3D WebGL device animations, media controls, and system monitoring.",
  "author": "WinLand Project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "electron .",
    "dist": "vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.winland.dynamicisland",
    "productName": "WinLand",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "shared/**/*",
      "build/**/*",
      "public/**/*",
      "scripts/**/*",
      "electron.js",
      "preload.js",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "draco3dgltf": "^1.5.7",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "meshoptimizer": "^1.2.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.1"
  }
}


